{
  "name": "picocache",
  "version": "0.0.0",
  "description": "Simple, enhanced localStorage and sessionStorage API.",
  "keywords": [
    "cache",
    "localStorage",
    "pico",
    "sessionStorage",
    "storage",
    "store"
  ],
  "bugs": {
    "url": "https://github.com/ColorlabHQ/picocache/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ColorlabHQ/picocache.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "files": [
    "dist/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "tag": "latest"
  },
  "scripts": {
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "build:base": "rolldown -c",
    "build:min": "cross-env NODE_ENV=production run-s build:base",
    "build": "run-s clean build:* size",
    "test": "vitest --coverage --ui",
    "coverage": "vitest run --coverage",
    "prepare": "simple-git-hooks",
    "publint": "publint",
    "check": "run-s lint coverage build publint"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.4",
    "rolldown-plugin-copy-files": "^0.2.0",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^13.0.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
